# ShellCheck 严格模式配置
# 与 LuciFanXpert 保持一致：开启全部规则，仅集中抑制经确认的误报。

enable=all

# SC2250：要求所有变量都写 ${var}。本项目统一用裸 $var，风格一致、可读性更好。
disable=SC2250

# SC2310 / SC2312：函数或命令替换放在 &&/|| 条件中会“掩盖返回值”。
# 本项目的错误处理刻意依赖这一行为：失败即 die/return，返回值不参与后续判断。
disable=SC2310
disable=SC2312

# SC2249：要求每个 case 都有 *) 分支。本项目惯用「单分支 case 做类型守卫」，
# 补一个空 *) 只是噪声；真正需要默认分支的场景都已在代码里显式补齐。
disable=SC2249

# SC2029：ssh 命令里的 $VAR 在本机展开。本项目刻意如此——远端脚本需要本机算出的
# 目标路径与库路径（$DEST/$LIBDIR），且这些值不含空格与特殊字符。
disable=SC2029

# SC2248：要求即使不含特殊字符也给变量加双引号。与已禁用的 SC2250 同源 ——
# 本项目统一用裸 $var / $?（需要防歧义时写 ${var}，例如后面紧跟中文标点时）。
disable=SC2248
