#!/bin/sh
# 确保存在一个可用的激活源；不做任何破坏性修改。

[ -f /etc/config/lucisysupgrade ] || exit 0

active="$(uci -q get lucisysupgrade.globals.active_source)"
if [ -n "$active" ] && [ "$(uci -q get lucisysupgrade.$active.url)" != "" ]; then
	exit 0
fi

for s in $(uci -q show lucisysupgrade | sed -n 's/^lucisysupgrade\.\([^.=]*\)=source$/\1/p'); do
	enabled="$(uci -q get lucisysupgrade.$s.enabled)"
	url="$(uci -q get lucisysupgrade.$s.url)"
	if [ "$enabled" != "0" ] && [ -n "$url" ]; then
		uci -q set lucisysupgrade.globals.active_source="$s"
		uci -q commit lucisysupgrade
		break
	fi
done

exit 0

# 按当前配置同步 crontab（只动自己的标记块）
if [ -x /usr/bin/lucisysupgrade ]; then
	/usr/bin/lucisysupgrade schedule --apply >/dev/null 2>&1 || true
fi
