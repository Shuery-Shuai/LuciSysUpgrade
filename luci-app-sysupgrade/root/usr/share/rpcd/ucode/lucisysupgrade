#!/usr/bin/env ucode
'use strict';

// rpcd ubus 对象：lucisysupgrade
// 只读：version / status / sources / check / download_status
// 写：  set_active / set_options / download / cancel / cleanup

let util = require('lucisysupgrade.util');
let local = require('lucisysupgrade.local');
let config = require('lucisysupgrade.config');
let source = require('lucisysupgrade.source');
let verdict = require('lucisysupgrade.verdict');
let state = require('lucisysupgrade.state');
let download = require('lucisysupgrade.download');
let uci = require('uci');

const VERSION = '0.2.0';
const CONFIG = 'lucisysupgrade';

function arg(req, name) {
	let a = req?.args ?? req ?? {};
	return trim(a[name] ?? '');
}

// 空字符串视为“不修改”，避免部分字段调用把 interval 误写成 0
function opt_int(v, fallback) {
	let s = trim(v ?? '');
	return length(s) ? util.to_int(s, fallback) : fallback;
}

function do_status() {
	return {
		version: VERSION,
		ts: util.now_epoch(),
		local: local.identity(),
		config: config.load(),
		last: state.load_last(),
		download: download.status()
	};
}

function do_sources() {
	let conf = config.load();
	return {
		active_source: conf.active_source,
		sources: conf.sources,
		unattended: conf.unattended,
		interval: conf.interval,
		enabled: conf.enabled
	};
}

function pick_source(conf, name) {
	return length(name)
		? (filter(conf.sources, function (s) { return s.name == name; })[0] ?? null)
		: config.active(conf);
}

function do_check(req) {
	let conf = config.load();
	let src = pick_source(conf, arg(req, 'source'));
	let loc = local.identity();

	if (src == null)
		return { ok: false, ts: util.now_epoch(), error: '没有可用的源', local: loc, remote: null, verdict: verdict.compare(loc, null) };

	let remote = source.probe(src, loc, arg(req, 'channel'));
	let result = {
		ok: remote.ok,
		ts: util.now_epoch(),
		version: VERSION,
		local: loc,
		remote: remote,
		verdict: verdict.compare(loc, remote),
		source: { name: src.name, label: src.label, url: src.url, layout: src.layout, system: src.system },
		unattended: conf.unattended,
		interval: conf.interval
	};
	state.save_last(result);
	return result;
}

function do_set_active(req) {
	let name = arg(req, 'source');
	let conf = config.load();
	let hit = filter(conf.sources, function (s) { return s.name == name; });

	if (!length(hit))
		return { ok: false, error: '未知的源：' + name };

	let ctx = uci.cursor();
	ctx.set(CONFIG, 'globals', 'active_source', name);
	if (!ctx.commit(CONFIG))
		return { ok: false, error: 'uci commit 失败' };

	// 切换源之后，上一源的检测结果必须作废
	state.clear_last();
	return { ok: true, active_source: name, config: config.load() };
}

function do_set_options(req) {
	let conf = config.load();
	let a = req?.args ?? req ?? {};
	let level = opt_int(a.unattended, conf.unattended);
	let interval = opt_int(a.interval, conf.interval);
	let webhook = trim(a.webhook ?? conf.webhook);

	if (level < 0 || level > 2)
		return { ok: false, error: 'unattended 必须是 0/1/2' };
	if (interval < 0 || interval > 168)
		return { ok: false, error: 'interval 必须在 0-168 小时之间' };
	if (length(webhook) && !match(webhook, /^https?:\/\/.+/))
		return { ok: false, error: 'webhook 必须是 http(s) 地址或留空' };

	let ctx = uci.cursor();
	ctx.set(CONFIG, 'globals', 'unattended', '' + level);
	ctx.set(CONFIG, 'globals', 'interval', '' + interval);
	ctx.set(CONFIG, 'globals', 'webhook', webhook);
	if (!ctx.commit(CONFIG))
		return { ok: false, error: 'uci commit 失败' };

	return { ok: true, config: config.load() };
}

return {
	lucisysupgrade: {
		version: { call: function () { return { version: VERSION }; } },
		status: { call: do_status },
		sources: { call: do_sources },
		check: { args: { source: '', channel: '' }, call: do_check },
		download_status: { call: function () { return download.status(); } },
		download: { args: { source: '', channel: '' }, call: function (req) { return download.start(arg(req, 'source'), arg(req, 'channel')); } },
		cancel: { call: function () { return download.cancel(); } },
		cleanup: { call: function () { return download.cleanup(); } },
		set_active: { args: { source: '' }, call: do_set_active },
		set_options: { args: { unattended: '', interval: '', webhook: '' }, call: do_set_options }
	}
};
