{
	"luci-app-sysupgrade": {
		"description": "Grant access to the LuCI system upgrade checker",
		"read": {
			"uci": [ "lucisysupgrade" ],
			"ubus": {
				"lucisysupgrade": [ "status", "sources", "check", "version", "download_status" ]
			}
		},
		"write": {
			"uci": [ "lucisysupgrade" ],
			"ubus": {
				"lucisysupgrade": [ "set_active", "set_options", "download", "cancel", "cleanup" ]
			}
		}
	}
}
