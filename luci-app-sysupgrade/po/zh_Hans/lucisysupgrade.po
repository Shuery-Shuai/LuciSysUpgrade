# menu
msgid "System Update"
msgstr "系统更新"

msgid "Update Check"
msgstr "更新检测"

msgid "Sources"
msgstr "源管理"

msgid "Settings"
msgstr "设置"

# overview
msgid "Read-only detection: the local build id is compared against the remote release metadata. This version does not download or flash anything."
msgstr "只读检测：用本机构建标识与远端发布元数据比对，判断是否存在更新。本版本不会下载或刷写任何东西。"

msgid "Check for updates"
msgstr "检查更新"

msgid "Local system"
msgstr "本机"

msgid "Build id"
msgstr "构建标识"

msgid "Source date"
msgstr "源码构建时间"

msgid "Board"
msgstr "板型"

msgid "Distribution"
msgstr "系统"

msgid "Result"
msgstr "检测结果"

msgid "No check has been run yet."
msgstr "尚未检测。"

msgid "checked at"
msgstr "检测于"

msgid "cached result from"
msgstr "缓存结果，来自"

msgid "Local build id"
msgstr "本机构建"

msgid "Local source date"
msgstr "本机源码时间"

msgid "Remote build id"
msgstr "远端构建"

msgid "Remote source date"
msgstr "远端源码时间"

msgid "channel"
msgstr "通道"

msgid "Detection failed"
msgstr "检测失败"

msgid "Unknown error"
msgstr "未知错误"

msgid "Item"
msgstr "项目"

msgid "Local"
msgstr "本机"

msgid "Remote"
msgstr "远端"

msgid "Channel"
msgstr "通道"

msgid "Source"
msgstr "源"

msgid "Profile"
msgstr "profile"

msgid "Verdict basis"
msgstr "判定依据"

msgid "Candidate image"
msgstr "候选镜像"

msgid "Value"
msgstr "值"

msgid "File"
msgstr "文件"

msgid "Size"
msgstr "体积"

msgid "All images (%d)"
msgstr "全部镜像（%d）"

msgid "Do not flash these by hand"
msgstr "不要手动刷写这些文件"

msgid "Only the squashfs sysupgrade image is offered as an upgrade candidate. Preloader, BL31/U-Boot, GPT and sdcard images rewrite the boot chain or the partition table; a wrong pick bricks the device instead of failing the upgrade."
msgstr "只有 squashfs 的 sysupgrade 镜像会作为升级候选。preloader、BL31/U-Boot、GPT 与 sdcard 镜像会改写引导链或分区表，选错的后果不是升级失败而是变砖。"

msgid "Type"
msgstr "类型"

msgid "Filesystem"
msgstr "文件系统"

msgid "Warning"
msgstr "提示"

msgid "Check failed: "
msgstr "检测失败："

# sources
msgid "Active"
msgstr "激活"

msgid "Name"
msgstr "名称"

msgid "State"
msgstr "状态"

msgid "Layout"
msgstr "布局"

msgid "Address"
msgstr "地址"

msgid "enabled"
msgstr "启用"

msgid "disabled"
msgstr "禁用"

msgid "Only one source is active at a time. Switching discards the previous check result, so that a verdict can never come from a source you are not looking at."
msgstr "同一时刻只有一个源生效；切换会作废上一次的检测结果，避免出现「结论来自另一个源」的情况。"

msgid "Save and apply"
msgstr "保存并应用"

msgid "Layouts"
msgstr "布局说明"

msgid "official: <base>/{snapshots|releases/<version>}/targets/<target>/<subtarget>/ — bin_targets_root: <base>/targets/<target>/<subtarget>/ (a raw bin/targets mirror)."
msgstr "official：<base>/{snapshots|releases/<版本>}/targets/<目标>/<子目标>/；bin_targets_root：<base>/targets/<目标>/<子目标>/（裸 bin/targets 镜像）。"

msgid "Disabled sources"
msgstr "关于禁用"

msgid "A source can stay in the list as disabled; it is not probed until it becomes the active one."
msgstr "源可以留在列表里但保持禁用；在它成为激活源之前不会被探测。"

msgid "Active source updated."
msgstr "激活源已更新。"

msgid "Save failed"
msgstr "保存失败"

msgid "Save failed: "
msgstr "保存失败："

# settings
msgid "Unattended level"
msgstr "无人值守档位"


msgid "detect and notify"
msgstr "仅检测并通知"

msgid "download automatically"
msgstr "自动下载"

msgid "flash automatically"
msgstr "自动刷写"

msgid "Check interval (hours)"
msgstr "检测间隔（小时）"

msgid "0 disables the scheduled check. The schedule is written into /etc/crontabs/root inside a marked block (M4); existing entries are never touched."
msgstr "0 表示关闭定时检测。定时任务会写入 /etc/crontabs/root 的标记块内（M4），绝不改动你已有的条目。"

msgid "Webhook URL"
msgstr "Webhook 地址"


msgid "Save"
msgstr "保存"

msgid "Settings saved."
msgstr "设置已保存。"

msgid "Where settings live"
msgstr "配置存放位置"

msgid "Everything is stored in /etc/config/lucisysupgrade, which is preserved by sysupgrade -k together with the rest of the configuration."
msgstr "全部配置存放在 /etc/config/lucisysupgrade，会随 sysupgrade -k 与其他配置一起保留。"

# M2 下载
msgid "Read-only detection plus image download. Nothing is flashed: this version stops after verifying the sha256."
msgstr "只读检测 + 镜像下载。不会刷写：本版本在 sha256 校验通过后就停下。"

msgid "Image download"
msgstr "镜像下载"

msgid "Downloads the candidate image to /tmp and verifies its sha256. Nothing is flashed."
msgstr "把候选镜像下载到 /tmp 并校验 sha256，不会刷写。"

msgid "Download image"
msgstr "下载镜像"

msgid "Downloading…"
msgstr "下载中…"

msgid "The file goes to /tmp (RAM). Flashing is not implemented yet, so nothing else happens when it finishes."
msgstr "文件落在 /tmp（内存），刷写尚未实现，因此下载完成后不会有后续动作。"

msgid "resumed"
msgstr "（续传）"

msgid "Cancel"
msgstr "取消"

msgid "Cancel failed"
msgstr "取消失败"

msgid "Cancel failed: "
msgstr "取消失败："

msgid "Downloaded and verified"
msgstr "已下载并通过校验"

msgid "The sha256 matches the one published by the source. This version does not flash anything."
msgstr "sha256 与源站公布的一致。本版本不会刷写。"

msgid "Download failed"
msgstr "下载失败"

msgid "Download failed: "
msgstr "下载失败："

msgid "Retry download"
msgstr "重试下载"

msgid "Resume download"
msgstr "继续下载"

msgid "Delete file"
msgstr "删除文件"

msgid "Downloaded file deleted."
msgstr "已删除下载的文件。"

msgid "Delete failed: "
msgstr "删除失败："

msgid "Download cancelled"
msgstr "下载已取消"

msgid "The partial file is kept, so a retry resumes instead of starting over (the ETag is compared first)."
msgstr "已下载的部分会保留，重试时续传而不是重来（续传前会先比对 ETag）。"

# 源管理（自定义源）与设置（定时任务）
msgid "Add a source"
msgstr "添加源"

msgid "Any static mirror that follows the official layout works. Pick a preset or fill the fields yourself."
msgstr "任何遵循官方目录结构的静态镜像都可以。选一个预设，或自己填。"

msgid "Preset"
msgstr "预设"

msgid "— pick a preset —"
msgstr "— 选择预设 —"

msgid "Identifier"
msgstr "标识"


msgid "Label"
msgstr "名称"

msgid "My mirror"
msgstr "我的镜像站"

msgid "optional, e.g. immortalwrt"
msgstr "可选，例如 immortalwrt"

msgid "official: <base>/{snapshots|releases/<version>}/targets/… — bin_targets_root: <base>/targets/…"
msgstr "official：<base>/{snapshots|releases/<版本>}/targets/…；bin_targets_root：<base>/targets/…"

msgid "System"
msgstr "系统"

msgid "path segment for mirrors that host several systems, e.g. rtfw/immortalwrt"
msgstr "聚合站的系统路径段，例如 rtfw 的 immortalwrt"

msgid "Add"
msgstr "添加"

msgid "Add failed"
msgstr "添加失败"

msgid "Add failed: "
msgstr "添加失败："

msgid "Delete"
msgstr "删除"

msgid "Delete failed"
msgstr "删除失败"

msgid "Delete failed: "
msgstr "删除失败："

msgid "Actions"
msgstr "操作"

msgid "Source added."
msgstr "源已添加。"

msgid "Source deleted."
msgstr "源已删除。"

msgid "ImmortalWrt official"
msgstr "ImmortalWrt 官方"

msgid "OpenWrt official"
msgstr "OpenWrt 官方"

msgid "RTFW mirror"
msgstr "RTFW 聚合站"

msgid "Own bin/targets mirror"
msgstr "自有 bin/targets 站"

msgid "Own build mirror"
msgstr "自有构建站"

msgid "Scheduled task"
msgstr "定时任务"


msgid "Every 6 hours"
msgstr "每 6 小时"

msgid "Every 12 hours"
msgstr "每 12 小时"

msgid "Daily"
msgstr "每天"

msgid "Every 2 days"
msgstr "每 2 天"

msgid "Weekly"
msgstr "每周"

msgid "Disabled"
msgstr "关闭"

msgid "Current: every %d hours"
msgstr "当前：每 %d 小时"

# 面向用户的文案（去掉开发术语）
msgid "0: detect and notify only. 1: also download automatically. 2: also flash automatically (not available yet)."
msgstr "0：仅检测并通知；1：额外自动下载；2：额外自动刷写（尚未提供）。"

msgid "How often the check runs unattended. It will be scheduled in /etc/crontabs/root, inside its own marked block, and never touches your existing entries. Not active yet."
msgstr "无人值守检测的频次。启用后会写进 /etc/crontabs/root 的独立标记块，绝不改动你已有的条目；当前尚未启用。"

msgid "POST JSON when update events happen. Leave empty to disable. Not active yet."
msgstr "发生更新事件时以 POST JSON 通知，留空即关闭；当前尚未启用。"

msgid "Delete source"
msgstr "删除源"

msgid "Delete source %s? Its section is removed from the configuration and the last check result is discarded."
msgstr "删除源 %s？该段会从配置中移除，最近一次检测结果也会作废。"

# 结构与日志（第二轮界面意见）
msgid "Overview"
msgstr "概览"

msgid "Logs"
msgstr "日志"

msgid "Check sources"
msgstr "检测源"

msgid "Detection and notification"
msgstr "检测与通知"

msgid "Save settings"
msgstr "保存设置"

msgid "Detection, source and download events, newest first. Stored in RAM (/tmp), so a reboot clears them."
msgstr "检测、源与下载事件，最新的在前。写在内存（/tmp）里，重启即清空。"

msgid "Refresh"
msgstr "刷新"

msgid "Clear log"
msgstr "清空日志"

msgid "Log cleared."
msgstr "日志已清空。"

msgid "Clear failed: "
msgstr "清空失败："

msgid "Refresh failed: "
msgstr "刷新失败："

msgid "No events yet."
msgstr "还没有事件。"

msgid "No downloader output yet."
msgstr "还没有下载器输出。"

msgid "Raw downloader output (tail)"
msgstr "下载器原始输出（尾部）"

msgid "Time"
msgstr "时间"

msgid "Event"
msgstr "事件"

msgid "Detail"
msgstr "说明"

msgid "Files: %s , %s"
msgstr "文件：%s 、%s"

# 添加源：字段顺序跟随表格；标识可自动生成
msgid "fills the fields below; you can edit everything afterwards"
msgstr "会自动填入下面的字段，填完仍可修改"

msgid "shown in the table; free text, duplicates allowed"
msgstr "表格里显示的就是它；随意写，允许重复"

msgid "auto-generated when empty"
msgstr "留空则自动生成"

msgid "internal UCI section name (lower-case letters, digits, underscore); normally you do not need to set it"
msgstr "内部用的 UCI 段名（小写字母、数字、下划线）；一般不需要填"

